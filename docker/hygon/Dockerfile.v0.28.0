# Copyright 2026 FlagOS Contributors
# Build context: repository root. Reconstituted vendor wheels come from the
# pinned validation artifact; the runtime layers start from the new 2.3.0 base.
ARG HYGON_BASE_IMAGE=harbor.baai.ac.cn/flagos-runtime/flagos-runtime-hygon-dtk26.04@sha256:03e598b348e58e7233628394bbefa0ccef26969a091c7e6f2f02835161757f8b
FROM harbor.baai.ac.cn/plugin/vllm-plugin-fl@sha256:e5a84bc28e4bfcae413e1e9288a605a49aea352ecc8b35f4b58b3ebba5e6fc9d AS artifacts
COPY docker/hygon/scripts/repack-installed.py /opt/repack-installed.py
COPY docker/hygon/scripts/patch-vllm-wheel.py /opt/patch-vllm-wheel.py
RUN /opt/vllm-fl/venv/bin/python -I -B /opt/repack-installed.py /opt/export torch flag-gems triton torchvision flash-attn \
 && cp /tmp/flagtree-0.6.0+hcu3.6-cp310-cp310-linux_x86_64.whl /opt/export/ \
 && echo '0fd81f0e691486dfaf85f6a196f9f09d66118b7d2064b4f8c70b6c8bfdb4d52c  /opt/export/flagtree-0.6.0+hcu3.6-cp310-cp310-linux_x86_64.whl' | sha256sum -c - \
 && /opt/vllm-fl/venv/bin/python -I -B /opt/patch-vllm-wheel.py /opt/hygon/wheels/vllm-0.28.0+empty-cp310-cp310-linux_x86_64.whl /opt/export

FROM ${HYGON_BASE_IMAGE} AS ci
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
ARG INDEX_URL=https://mirrors.aliyun.com/pypi/simple
ARG PLUGIN_SOURCE_SHA=72eaf18e61d5015b70988cb03a7ba3eeee0dc8b9
ARG FLAGGEMS_VLLM_SHA=f775b37f3066e2935742d26c7592a5dd55499159
ENV PATH=/flagos/bin:${PATH} PYTHONPATH="" VLLM_VENDOR="" \
    GEMS_VENDOR=hygon USE_FLAGGEMS=1 VLLM_PLUGINS=fl \
    VLLM_USE_V2_MODEL_RUNNER=0 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HYGON_FLAGGEMS_VERSION=0.1.0 HYGON_FLAGTREE_VERSION=0.6.0+hcu3.6
COPY docker/hygon/scripts/runtime-env.sh /etc/profile.d/zz-flagos.sh
COPY --from=artifacts /opt/export/ /opt/release/vendor-wheels/
RUN mkdir -p /opt/release /opt/src \
 && python -m pip uninstall -y flagcx \
 && ln -s /opt/dtk /opt/rocm
# Pin every changed public package from the tested container. --no-deps keeps
# pip from replacing the vendor compiler/Torch stack with upstream CUDA wheels.

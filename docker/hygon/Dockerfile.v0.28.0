      zstandard==0.25.0 \
      > /opt/release/public-pins.txt \
 && python -m pip install --no-deps --index-url "$INDEX_URL" -r /opt/release/public-pins.txt
RUN python -m pip install --no-deps --no-index /opt/release/vendor-wheels/flagtree-*.whl \
 && python -m pip install --no-deps --no-index \
      /opt/release/vendor-wheels/torch-*.whl \
      /opt/release/vendor-wheels/triton-*.whl \
      /opt/release/vendor-wheels/flag_gems-*.whl \
      /opt/release/vendor-wheels/torchvision-*.whl \
      /opt/release/vendor-wheels/flash_attn-*.whl \
      /opt/release/vendor-wheels/vllm-*.whl
RUN git -C /opt/src init plugin \
 && git -C /opt/src/plugin fetch --depth 1 https://github.com/BrianPei/vllm-plugin-FL.git "$PLUGIN_SOURCE_SHA" \
 && git -C /opt/src/plugin reset --hard FETCH_HEAD \
 && SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_PLUGIN_FL="0.0.0+g${PLUGIN_SOURCE_SHA}" \
      python -m pip wheel --no-deps --no-build-isolation --wheel-dir /opt/release/wheels /opt/src/plugin \
 && python -m pip install --no-deps --no-index /opt/release/wheels/vllm_plugin_fl-*.whl
# Fetch exactly the required commit, then use a full local clone to preserve
# canonical Git provenance without a slow history/partial-clone fetch.
RUN git -C /opt/src init flaggems-vllm \
 && git -C /opt/src/flaggems-vllm fetch --depth 1 https://github.com/flagos-ai/FlagGems-vllm.git "$FLAGGEMS_VLLM_SHA" \
 && git -C /opt/src/flaggems-vllm reset --hard FETCH_HEAD \
 && mkdir -p /opt/build-git \
 && printf '%s\n' '#!/bin/bash' 'args=()' 'for arg in "$@"; do if [ "$arg" != "--filter=blob:none" ]; then args+=("$arg"); fi; done' 'exec /usr/bin/git "${args[@]}"' > /opt/build-git/git \
 && chmod +x /opt/build-git/git \
 && PATH="/opt/build-git:$PATH" GIT_NO_LAZY_FETCH=1 GIT_CONFIG_COUNT=1 \
      GIT_CONFIG_KEY_0=url.file:///opt/src/flaggems-vllm.insteadOf \
      GIT_CONFIG_VALUE_0=https://github.com/flagos-ai/FlagGems-vllm.git \
      python /opt/src/plugin/.github/scripts/install_flaggems_vllm.py \
 && python -m pip check \
 && python -m pip freeze --all > /opt/release/requirements.lock.txt \
 && printf '%s\n' "$PLUGIN_SOURCE_SHA" > /opt/release/plugin-source-sha.txt \
 && printf '%s\n' "$FLAGGEMS_VLLM_SHA" > /opt/release/flaggems-vllm-source-sha.txt \
 && python -I -B /opt/src/plugin/.github/scripts/hygon/verify_install.py --static-only
LABEL org.opencontainers.image.revision=${PLUGIN_SOURCE_SHA}
WORKDIR /workspace
CMD ["/bin/bash"]
